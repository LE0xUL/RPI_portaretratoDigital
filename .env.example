# Código que se pide una sola vez para entrar al panel de administración.
# Cambialo antes de exponer esto en tu red.
INVITE_CODE=change-me-1234

# Usado para firmar la cookie de sesión. Generá algo largo y random, ej:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-long-random-string

# Puerto en el host donde queda expuesto el servicio
PORT=8080

# Zona horaria usada por el contenedor (para logs y, si hiciera falta, timestamps del backend)
TZ=America/Argentina/Buenos_Aires
